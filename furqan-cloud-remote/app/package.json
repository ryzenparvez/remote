{
  "name": "furqan-cloud-remote",
  "version": "1.0.0",
  "description": "Furqan Cloud Remote Access - Secure, Fast, Simple Remote Access",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@fontsource/inter": "^5.0.20"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.furqancloud.remote",
    "productName": "Furqan Cloud Remote Access",
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Furqan Cloud Remote Access"
    },
    "artifactName": "${productName} Setup ${version}.${ext}"
  }
}
